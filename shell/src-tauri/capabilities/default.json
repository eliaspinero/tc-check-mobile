{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, and for the tc-check client the local server serves",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:8000/**"
        },
        {
          "url": "http://127.0.0.1:19119/**"
        }
      ]
    },
    "log:default"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8000/*",
      "http://127.0.0.1:19119/*"
    ]
  }
}